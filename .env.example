# Copy this file to .env and fill in real values. .env is gitignored.
# Per spec §6.6 rule 4, NEVER commit .env or any filled-in variant.

# --- Server ---
LAGOON_SERVER_PORT=8080
# Loopback by default. Non-loopback binds are allowed only when LAGOON_API_TOKEN
# is set (V2 A5) — every /api/* route then requires the bearer token.
LAGOON_SERVER_HOST=127.0.0.1

# --- Per-install API token (V2 A5, OPTIONAL) ---
# Empty = legacy loopback-only posture, no auth. Set = Bearer required on
# /api/*, non-loopback binds allowed. Same value on the client via
# LAGOON_API_TOKEN env or the settings store. Rotation = change both ends.
LAGOON_API_TOKEN=

# --- Gmail push webhook shared secret (V2 A4, OPTIONAL) ---
# Empty = POST /webhook/gmail stays 501 and the 30s poller is the sync path.
# Set = Pub/Sub push subscription forwards here with Authorization: Bearer.
LAGOON_WEBHOOK_SECRET=

# --- Credential encryption (REQUIRED) ---
# AES-GCM key for the sealed accounts.credentials blob (Gmail tokens and QQ
# authorization codes). Must be 32 random bytes, base64-encoded. The server
# refuses to start without it. Rotating it invalidates stored credentials.
# Generate with: openssl rand -base64 32
LAGOON_TOKEN_KEY=

# --- Client (macOS app) ---
# Base URL the app polls; must match LAGOON_SERVER_HOST/PORT above.
LAGOON_SERVER_URL=http://127.0.0.1:8080
# Same value as the server's LAGOON_API_TOKEN when auth is enabled.
# LAGOON_API_TOKEN=

# --- Outbound proxy (dev machines that cannot reach Google directly) ---
# Set to your local proxy (e.g. Clash mixed port). Leave empty for direct.
LAGOON_HTTP_PROXY=http://127.0.0.1:7897

# --- Database (local Docker or Fly.io) ---
# Local Docker example (container mapped to host port 5433 because a local
# Homebrew postgres already owns 127.0.0.1:5432):
DATABASE_URL=postgres://lagoon:lagoon@127.0.0.1:5433/lagoon
# Fly.io example (use 6PN internal address, not public):
# DATABASE_URL=postgres://lagoon:<password>@<app-name>.flycast:5432/lagoon

# --- Gmail OAuth (https://console.cloud.google.com) ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/oauth/gmail/callback
# Pub/Sub topic for Gmail push (M0 wires the endpoint, M1+ wires the topic):
GMAIL_PUBSUB_TOPIC=

# --- LLM Provider (MiniMax-M3, MiniMax 国内版本) ---
# Per spec §6.5, additional providers can be added in config/providers.json.
# The base URL must be an OpenAI-compatible endpoint: the provider posts to
# {BASE_URL}/chat/completions with a Bearer token. MiniMax's Anthropic-
# compatible endpoint (https://api.minimax.cn/anthropic) answers 404 there
# and surfaces as HTTP 502 {"error":"ai-error"} from /api/messages/*/summary.
# Leave BASE_URL empty to use config/providers.json (already correct).
LLM_PROVIDER_PRIMARY_API_KEY=
LLM_PROVIDER_PRIMARY_BASE_URL=
LLM_PROVIDER_PRIMARY_MODEL=MiniMax-M3

# Language the AI writes summaries / action items in (BCP-47 tag).
# Group identifiers and JSON keys stay English because they are parsed.
LAGOON_AI_LANGUAGE=zh-Hans

# --- LLM monthly cost cap (spec §6.5) ---
# Set > 0 to enforce. The cap is in USD per month. When exceeded, /summary and
# /api/briefing return 503 {"error":"ai-budget-exceeded"}. NIL/0 disables.
# Enforcement also requires non-null prompt/completion token rates in
# config/providers.json. Without them, calls are counted but the dollar cap is
# reported as unavailable in the usage panel.
# Cost per call = prompt_tokens/1000 * costPer1kPromptUsd + completion_tokens/1000 *
# costPer1kCompletionUsd. Configure those rates in config/providers.json; nil
# rates mean calls can still be counted, but the dollar cap is not enforced.
LAGOON_BUDGET_USD_PER_MONTH=10

# --- Misc ---
LAGOON_LOG_LEVEL=info
