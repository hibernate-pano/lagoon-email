# Copy this file to .env and fill in real values. .env is gitignored.
# Per spec §6.6 rule 4, NEVER commit .env or any filled-in variant.
#
# V3 embedded runtime: the APP does not read this file — it holds its key and
# API token in the Keychain and migrates AI keys from the legacy .env once.
# This file is the env contract for development (LagoonServerCLI and
# `swift run Lagoon`), where these variables are read from the environment.

# --- Server (CLI/dev only; the embedded app binds 127.0.0.1 and picks a port) ---
LAGOON_SERVER_HOST=127.0.0.1
LAGOON_SERVER_PORT=8080
# Bearer token required on /api/* when set; empty = loopback-only, no auth.
LAGOON_API_TOKEN=

# --- Credential encryption (REQUIRED for the CLI) ---
# AES-GCM key for the sealed accounts.credentials blob (QQ authorization
# codes). Must be 32 random bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# (The embedded app generates and stores this in the Keychain automatically.)
LAGOON_TOKEN_KEY=

# --- Embedded SQLite store (CLI/dev; default: Application Support/Lagoon) ---
# LAGOON_DB_PATH=/path/to/lagoon.sqlite

# --- Client (macOS app) ---
# Base URL the app polls when running against a dev CLI server. The embedded
# app ignores this and talks to its own in-process server.
LAGOON_SERVER_URL=http://127.0.0.1:8080

# --- Outbound proxy (for the LLM provider; e.g. restricted networks) ---
# Set to your local proxy (e.g. Clash mixed port). Leave empty for direct.
LAGOON_HTTP_PROXY=http://127.0.0.1:7897

# --- LLM Provider (MiniMax-M3, MiniMax 国内版本) ---
# Per spec §6.5, additional providers can be added in config/providers.json.
# The base URL must be an OpenAI-compatible endpoint: the provider posts to
# {BASE_URL}/chat/completions with a Bearer token. Leave BASE_URL empty to use
# config/providers.json (already correct).
LLM_PROVIDER_PRIMARY_API_KEY=
LLM_PROVIDER_PRIMARY_BASE_URL=
LLM_PROVIDER_PRIMARY_MODEL=MiniMax-M3

# Language the AI writes summaries / action items in (BCP-47 tag).
LAGOON_AI_LANGUAGE=zh-Hans

# --- LLM monthly cost cap (spec §6.5) ---
# USD per month; exceeded → /summary and /api/briefing return 503
# {"error":"ai-budget-exceeded"}. 0/unset disables enforcement.
LAGOON_BUDGET_USD_PER_MONTH=10

# --- Misc ---
LAGOON_LOG_LEVEL=info
