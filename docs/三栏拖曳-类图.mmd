classDiagram
    direction LR

    class ColumnId {
        <<enum>>
        sidebar
        list
        reader
        rawValue~String~
        ownsHandle~Bool~
    }

    class ColumnSpec {
        +CGFloat softMin
        +CGFloat min
        +CGFloat ideal
        +CGFloat max
        +CGFloat weight
        +Int shrinkRank
        +Bool elastic
        +String labelKey
    }

    class ColumnSpecs {
        <<static>>
        +specs~[ColumnSpec; 3]~
        +divider~CGFloat = 6~
        +handleHitWidth~CGFloat = 10~
        +windowMinWidth~CGFloat = 832~
        +subscript(ColumnId)~ColumnSpec~
    }

    class ColumnWidths {
        +CGFloat sidebar
        +CGFloat list
        +CGFloat reader
        +subscript(ColumnId)~CGFloat~
        +total()~CGFloat~
    }

    class SolverRequest {
        +CGFloat available
        +ColumnId? drag
        +CGFloat? rawWidth
        +ColumnWidths? persisted
    }

    class SolveResult {
        +ColumnWidths widths
        +[CGFloat] floors
        +[CGFloat] ceils
        +Bool degraded
        +ValidateReport validate()
    }

    class ColumnSolver {
        <<enum, pure>>
        +floors(S)~[CGFloat]~
        +nominalCeil(ColumnId, floors, S)~CGFloat~
        +fill(R, cols, lo, hi)~[ColumnId: CGFloat]~
        +resolve(SolverRequest)~SolveResult~
        +launch(S, sidebar, list)~ColumnWidths~
        +reset(S)~ColumnWidths~
    }

    class DragPhase {
        <<enum>>
        idle
        arming
        dragging
        rubberBanding
    }

    class ColumnResizeStore {
        +ObservableObject
        +ColumnWidths widths
        +DragPhase phase
        +ColumnId? activeColumn
        +CGFloat dragAnchor
        +CGFloat availableWidth
        -floors~[CGFloat]~
        -ceils~[CGFloat]~
        +onAvailableWidthChanged(CGFloat)~
        +beginDrag(ColumnId)~
        +updateDrag(rawWidth)~CGFloat~
        +endDrag()~
        +resetToIdeal()~
        -persist()~
        -restore()~
    }

    class ColumnDividerHandle {
        +ColumnId column
        +CGFloat width
        +Bool isActive
        +onDragBegan~(ColumnId) -> Void~
        +onDragChanged~(ColumnId, CGFloat) -> Void~
        +onDragEnded~(ColumnId) -> Void~
        +onDoubleClick~() -> Void~
    }

    class ThreeColumnLayout {
        +ColumnWidths widths
        +sidebar~View~
        +listAndReader~View~
        +onWidthsChanged~(ColumnWidths) -> Void~
    }

    ColumnSpecs --> ColumnSpec : specs
    ColumnSpecs --> ColumnId : 索引
    SolverRequest --> ColumnId : drag
    ColumnSolver ..> SolveResult : 产生
    ColumnSolver ..> ColumnWidths : 产生
    ColumnResizeStore --> ColumnSolver : 驱动
    ColumnResizeStore --> ColumnSpecs : 读取
    ColumnResizeStore *-- DragPhase
    ColumnDividerHandle --> ColumnResizeStore : 事件
    ThreeColumnLayout --> ColumnDividerHandle : 渲染 2 个
    ThreeColumnLayout --> ColumnWidths : 渲染 3 栏 frame
    ColumnResizeStore ..> ColumnWidths : 发布
