# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Build artifacts (Package.resolved IS committed: this is an app, not a
# library, and exact dependency pins must be reproducible)
.build/
.swiftpm/
DerivedData/
dist/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/

# The .iconset is regenerated by scripts/build-icon.py; the resulting
# .icns IS committed so a fresh checkout builds without Pillow.
Support/Lagoon.iconset/

# OS noise
.DS_Store
*.swp
*.swo

# Docker
.docker-data/

# Local agent / tooling scratch (never part of the product)
.mimosa/
.pi/
.v2c/
.video_agent/
