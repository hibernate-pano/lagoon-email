# Copy this file to .env and fill in real values. .env is gitignored.
# Per spec §6.6 rule 4, NEVER commit .env or any filled-in variant.

# --- Server ---
LAGOON_SERVER_PORT=8080
LAGOON_SERVER_HOST=127.0.0.1

# --- Outbound proxy (dev machines that cannot reach Google directly) ---
# Set to your local proxy (e.g. Clash mixed port). Leave empty for direct.
LAGOON_HTTP_PROXY=http://127.0.0.1:7897

# --- Database (local Docker or Fly.io) ---
# Local Docker example (container mapped to host port 5433 because a local
# Homebrew postgres already owns 127.0.0.1:5432):
DATABASE_URL=postgres://lagoon:lagoon@127.0.0.1:5433/lagoon
# Fly.io example (use 6PN internal address, not public):
# DATABASE_URL=postgres://lagoon:<password>@<app-name>.flycast:5432/lagoon

# --- Gmail OAuth (https://console.cloud.google.com) ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/oauth/gmail/callback
# Pub/Sub topic for Gmail push (M0 wires the endpoint, M1+ wires the topic):
GMAIL_PUBSUB_TOPIC=

# --- LLM Provider (MiniMax-M3, MiniMax 国内版本) ---
# Per spec §6.5, additional providers can be added in config/providers.json
LLM_PROVIDER_PRIMARY_API_KEY=
LLM_PROVIDER_PRIMARY_BASE_URL=
LLM_PROVIDER_PRIMARY_MODEL=MiniMax-M3

# --- Misc ---
LAGOON_LOG_LEVEL=info