# 开发环境变量清单 —— 只列代码真正读取的变量。
#
# 产品（dist/Lagoon.app）不读 .env：外壳在首次启动时生成 keys.json，
# 再把下面这些值注入后端进程。只有手动运行 lagoon-api / 外壳 / 脚本时，
# 才需要自己设置。本文件不是被自动加载的配置，而是变量契约的说明书。
#
# 密钥只从环境变量进入进程，不要放到命令行参数里：argv 对同机所有进程可见。

# --- 必填 ---
# 32 字节 body key 的 base64；缺省或非法时后端拒绝启动。
#   openssl rand -base64 32
LAGOON_BODY_KEY=

# API bearer token；空值等于配置错误，后端拒绝启动（没有“无鉴权模式”）。
#   openssl rand -hex 24
LAGOON_API_TOKEN=

# --- 账号与写路径 ---
# 32 字节 token key 的 base64，用于封装 accounts.credentials。
# 缺失时后端仍可启动（只读部署），但连接账号与远端写操作会返回 503。
LAGOON_TOKEN_KEY=

# --- 存储位置 ---
# 优先级：--db 参数 > LAGOON_DB_PATH > LAGOON_V4_DATA_DIR/lagoon.sqlite > 默认 .dev/data。
# LAGOON_DB_PATH 指向 SQLite 文件本身；LAGOON_V4_DATA_DIR 指向目录。
LAGOON_DB_PATH=
LAGOON_V4_DATA_DIR=

# --- 监听 ---
# 默认 127.0.0.1:8080；端口 0 表示让内核分配（外壳就是这样启动后端的）。
LAGOON_SERVER_HOST=127.0.0.1
LAGOON_SERVER_PORT=8080

# --- 邮箱 provider ---
# none（默认）：不连接任何真实邮箱，测试与合成数据使用。
# production：真实的 IMAP/TLS 适配器。其他值会让后端拒绝启动。
LAGOON_MAIL_PROVIDER=none

# --- 用量报告 ---
# /api/usage 展示的月度上限；0 表示“未设置上限”。
# AI 未实现，这个值当前不影响任何 AI 行为。
LAGOON_BUDGET_USD_PER_MONTH=0

# --- 外壳开发覆盖（产品运行不需要） ---
# 仓库根目录；用于从任意目录启动 shell。
LAGOON_V4_ROOT=
# 开发期 keys.json 路径；缺省 <repo>/.dev/keys.json。
LAGOON_V4_KEYS=
# 后端选择：rust（默认）或 swift（遗留参考后端，产品不打包它的二进制）。
LAGOON_V4_BACKEND=rust
# 直接指定 lagoon-api 二进制；缺省在 crates/target/{release,debug} 与
# app 包的 Contents/Resources 里找。
LAGOON_V4_RUST_API=

# 说明（不是输入）：
# - LAGOON_PORT 由后端绑定端口后打印到 stdout（LAGOON_PORT=<u16>），供外壳握手；
#   不要手动设置。
# - LAGOON_V4_SIDECAR 只用于给遗留 Swift 后端指定二进制，产品链路不使用。
